{
    "name": "dblab/estudantes",
    "description": "Ambiente de estudos com MySQL, phpMyAdmin e criacao de schemas por aluno/professor",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.9",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs": "php-cs-fixer fix --diff --dry-run",
        "cs:fix": "php-cs-fixer fix",
        "migrate": "php bin/console.php migrate",
        "migrate:rollback": "php bin/console.php migrate:rollback",
        "migrate:status": "php bin/console.php migrate:status",
        "db:seed": "php bin/console.php db:seed",
        "hooks:install": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks && echo 'Hook de pre-push ativado (.githooks/pre-push).' || true",
        "post-install-cmd": [
            "@hooks:install"
        ]
    }
}
