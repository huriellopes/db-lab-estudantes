# Modelo do .env real de produção (fica só no servidor, NUNCA no git).
# Copie para .env na pasta do projeto no servidor e preencha com senhas fortes de verdade.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=schoolapp
MYSQL_USER=appuser
MYSQL_PASSWORD=

# --- Portas no servidor ---
# MYSQL_PORT: porta pública do MySQL (conexão direta por SGBD). Use uma porta que não
# colida com outros serviços do servidor.
# PMA_PORT: porta do phpMyAdmin, publicada só em 127.0.0.1 (o acesso público passa pelo
# proxy reverso).
MYSQL_PORT=
PMA_PORT=

# --- Endereço mostrado na página "Conectar via SGBD" ---
DB_PUBLIC_HOST=db.seu-dominio.com

# --- URL pública do phpMyAdmin (um host no proxy reverso apontando pro container
# dblab-phpmyadmin:80). Com isso preenchido, o link "Abrir phpMyAdmin" aparece pra qualquer
# usuário logado; sem PMA_URL, a app esconde o link. ---
PMA_URL=https://pma.seu-dominio.com

# --- Chave usada só pra criptografar (não é a senha em si) a senha em cache de sessão que
# o console SQL do dashboard usa pra conectar no MySQL como a própria pessoa. Gere com:
#   php -r 'echo base64_encode(random_bytes(32)) . PHP_EOL;'
# Trocar essa chave derruba as sessões com senha em cache (só precisa logar de novo).
APP_KEY=

# --- SMTP usado pelo fluxo "esqueci minha senha" (App\Core\Mailer). Sem MAIL_HOST
# preenchido, a app não quebra — só não envia o e-mail (fica registrado no log).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DB Lab Estudantes"

# --- Admin: cadastre-se pela app e rode, no servidor, ---
# --- `docker compose -f docker-compose.prod.yml exec app php bin/console.php user:promote-admin <email>` ---
