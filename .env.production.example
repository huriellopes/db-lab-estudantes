# Modelo do .env real de produção (fica só no servidor, NUNCA no git).
# Copie para /apps/db-lab-estudantes/.env no Contabo e preencha com senhas fortes de verdade.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=schoolapp
MYSQL_USER=appuser
MYSQL_PASSWORD=

# --- Portas em 127.0.0.1 no servidor (acesso só via túnel SSH) ---
MYSQL_PORT=13306
PMA_PORT=18081

# --- Endereço mostrado na página "Conectar via SGBD" ---
DB_PUBLIC_HOST=dblab.217.76.60.113.sslip.io

# --- URL pública do phpMyAdmin (proxy host próprio no Nginx Proxy Manager, apontando pro
# container dblab-phpmyadmin:80). Com isso preenchido, o link "Abrir phpMyAdmin" aparece
# pra qualquer usuário logado — sem PMA_URL, a app volta a esconder o link (só o túnel
# SSH continua funcionando, igual antes). ---
PMA_URL=https://pma.dblab.217.76.60.113.sslip.io

# --- Chave usada só pra criptografar (não é a senha em si) a senha em cache de sessão que
# o console SQL do dashboard usa pra conectar no MySQL como a própria pessoa. Gere com:
#   php -r 'echo base64_encode(random_bytes(32)) . PHP_EOL;'
# Trocar essa chave derruba as sessões com senha em cache (só precisa logar de novo).
APP_KEY=

# --- E-mail promovido a admin via `docker compose exec app php bin/console.php db:seed` ---
ADMIN_EMAIL=huriellopes1996@gmail.com
