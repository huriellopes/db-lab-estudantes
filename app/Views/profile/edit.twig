{% extends 'layouts/app.twig' %}
{% import 'macros/forms.twig' as forms %}

{% block content %}
    {% set user = auth_user() %}

    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Meu perfil</h1>
        <p class="mt-1 text-sm text-slate-500">Atualize seu nome de exibição e sua senha.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
        <div class="card h-fit">
            <h2 class="mb-4 text-base font-semibold text-slate-900">Dados da conta</h2>

            <form
                hx-boost="false" x-data="ajaxForm()" @submit.prevent="submit"
                method="post" action="/profile" class="space-y-4"
            >
                {{ csrf_field() }}
                <div>
                    <label for="name" class="field-label">Nome</label>
                    <input type="text" id="name" name="name" value="{{ user.name }}" required minlength="2" class="field-input">
                </div>
                <div>
                    <span class="field-label">E-mail</span>
                    <p class="rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-500">{{ user.email }}</p>
                </div>
                <button :disabled="loading" type="submit" class="btn-primary w-full">
                    <span x-show="!loading">Salvar nome</span>
                    <span x-show="loading" x-cloak>Salvando…</span>
                </button>
            </form>
        </div>

        <div class="card h-fit">
            <h2 class="mb-1 text-base font-semibold text-slate-900">Trocar senha</h2>
            <p class="mb-4 text-sm text-slate-500">Atualiza também a senha da sua conta MySQL (usada no phpMyAdmin).</p>

            <form
                hx-boost="false" x-data="ajaxForm({ onSuccess: () => $el.reset() })" @submit.prevent="submit"
                method="post" action="/profile/password" class="space-y-4"
            >
                {{ csrf_field() }}
                {{ forms.password_field('current_password', 'current_password', 'Senha atual') }}
                {{ forms.password_field('new_password', 'new_password', 'Nova senha', password_min_length) }}
                {{ forms.password_field('new_password_confirm', 'new_password_confirm', 'Confirmar nova senha', password_min_length) }}
                <button :disabled="loading" type="submit" class="btn-primary w-full">
                    <span x-show="!loading">Atualizar senha</span>
                    <span x-show="loading" x-cloak>Atualizando…</span>
                </button>
            </form>
        </div>

        <div class="card h-fit sm:col-span-2">
            <h2 class="mb-1 text-base font-semibold text-slate-900">Login do phpMyAdmin</h2>
            <p class="mb-4 text-sm text-slate-500">
                É a mesma conta usada para entrar no MySQL/phpMyAdmin. Renomear <strong>não</strong> muda
                o nome dos schemas — nem os que você já criou, nem o prefixo dos próximos. Só o login em si
                muda (os acessos continuam funcionando).
            </p>

            <form
                hx-boost="false" x-data="ajaxForm({
                    confirmTitle: 'Renomear login',
                    confirmMessage: (e) => `Renomear seu login MySQL de '{{ user.mysqlLogin|e('js') }}' para '${e.target.querySelector('#mysql_login').value}'? Conexões já salvas em algum SGBD local vão parar de funcionar até você atualizar o usuário lá.`,
                    confirmLabel: 'Renomear',
                    onSuccess: () => location.reload(),
                })"
                @submit.prevent="submit"
                method="post" action="/profile/mysql-login" class="flex flex-col gap-3 sm:flex-row sm:items-end"
            >
                {{ csrf_field() }}
                <div class="flex-1">
                    <label for="mysql_login" class="field-label">Novo login</label>
                    <input
                        type="text" id="mysql_login" name="mysql_login" value="{{ user.mysqlLogin }}"
                        pattern="[a-z](?!.*__)[a-z0-9_]{1,30}[a-z0-9]" maxlength="32" required class="field-input font-mono"
                    >
                </div>
                <button :disabled="loading" type="submit" class="btn-secondary">
                    <span x-show="!loading">Renomear</span>
                    <span x-show="loading" x-cloak>Renomeando…</span>
                </button>
            </form>
        </div>
    </div>
{% endblock %}
