        {# =============================== AVANÇADO =============================== #}
        <section x-show="level === 'avancado'" x-cloak class="space-y-6">
            <div class="card guia">
                <h2>1. Funções de janela (window functions)</h2>
                <p>
                    O <code>GROUP BY</code> espreme as linhas: depois dele, você só vê o resumo. As <strong>funções de
                    janela</strong> calculam sobre um grupo de linhas <em>sem juntar as linhas</em>: cada linha continua lá,
                    ganhando uma coluna extra com a conta. A palavra mágica é <code>OVER (...)</code>.
                </p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
-- Cada matrícula, ao lado da média do curso e da posição do aluno no curso
SELECT c.nome AS curso,
       a.nome AS aluno,
       m.nota,
       AVG(m.nota) OVER (PARTITION BY m.curso_id)                    AS media_do_curso,
       RANK()      OVER (PARTITION BY m.curso_id ORDER BY m.nota DESC) AS posicao
FROM matricula m
JOIN aluno a ON a.id = m.aluno_id
JOIN curso c ON c.id = m.curso_id
WHERE m.nota IS NOT NULL
ORDER BY c.nome, posicao;
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' %}{% block out -%}
+----------------+------------+------+----------------+---------+
| curso          | aluno      | nota | media_do_curso | posicao |
+----------------+------------+------+----------------+---------+
| Banco de Dados | Ana Souza  |  9.5 |        7.66667 |       1 |
| Banco de Dados | Elisa Melo |  7.0 |        7.66667 |       2 |
| Banco de Dados | Bruno Lima |  6.5 |        7.66667 |       3 |
| Python         | Ana Souza  |  8.0 |        8.00000 |       1 |
| Redes          | Elisa Melo |  5.5 |        5.50000 |       1 |
+----------------+------------+------+----------------+---------+
{%- endblock %}{% endembed %}
                <ul>
                    <li><code>PARTITION BY</code> — define os grupos (as "janelas"), parecido com o GROUP BY.</li>
                    <li><code>ORDER BY</code> dentro do OVER — define a ordem dentro de cada janela.</li>
                    <li><code>ROW_NUMBER()</code> numera 1, 2, 3...; <code>RANK()</code> repete a posição em caso de empate e pula a seguinte; <code>DENSE_RANK()</code> repete sem pular.</li>
                    <li><code>LAG()</code>/<code>LEAD()</code> leem a linha anterior/seguinte; <code>SUM(...) OVER (ORDER BY ...)</code> faz soma acumulada.</li>
                </ul>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
-- Faturamento acumulado ao longo das matrículas
SELECT m.data_matricula,
       c.preco,
       SUM(c.preco) OVER (ORDER BY m.data_matricula) AS acumulado
FROM matricula m
JOIN curso c ON c.id = m.curso_id
ORDER BY m.data_matricula;
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' %}{% block out -%}
+----------------+--------+-----------+
| data_matricula | preco  | acumulado |
+----------------+--------+-----------+
| 2026-02-01     | 450.00 |    450.00 |
| 2026-02-03     | 520.00 |    970.00 |
| 2026-02-05     | 450.00 |   1420.00 |
| 2026-03-10     | 150.00 |   1570.00 |
| 2026-03-12     | 450.00 |   2020.00 |
| 2026-03-15     | 380.00 |   2400.00 |
+----------------+--------+-----------+
{%- endblock %}{% endembed %}
            </div>

            <div class="card guia">
                <h2>2. CTE recursiva</h2>
                <p>
                    Uma CTE pode <strong>chamar a si mesma</strong>. Isso serve pra percorrer estruturas em árvore
                    (categorias e subcategorias, organograma) ou gerar sequências.
                </p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
CREATE TABLE categoria (
    id      INT PRIMARY KEY,
    nome    VARCHAR(40) NOT NULL,
    pai_id  INT NULL,
    FOREIGN KEY (pai_id) REFERENCES categoria (id)
);
INSERT INTO categoria VALUES
    (1, 'Tecnologia', NULL),
    (2, 'Programação', 1),
    (3, 'Banco de Dados', 2),
    (4, 'Python', 2),
    (5, 'Infraestrutura', 1);

WITH RECURSIVE arvore AS (
    SELECT id, nome, pai_id, 0 AS nivel, CAST(nome AS CHAR(200)) AS caminho
    FROM categoria
    WHERE pai_id IS NULL                 -- ponto de partida: a raiz
    UNION ALL
    SELECT c.id, c.nome, c.pai_id, a.nivel + 1, CONCAT(a.caminho, ' > ', c.nome)
    FROM categoria c
    JOIN arvore a ON c.pai_id = a.id     -- passo recursivo: os filhos
)
SELECT nivel, caminho FROM arvore ORDER BY caminho;
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' %}{% block out -%}
+-------+-------------------------------------------+
| nivel | caminho                                   |
+-------+-------------------------------------------+
|     0 | Tecnologia                                |
|     1 | Tecnologia &gt; Infraestrutura               |
|     1 | Tecnologia &gt; Programação                  |
|     2 | Tecnologia &gt; Programação &gt; Banco de Dados |
|     2 | Tecnologia &gt; Programação &gt; Python         |
+-------+-------------------------------------------+
{%- endblock %}{% endembed %}
            </div>

            <div class="card guia">
                <h2>3. Operações de conjunto e VIEW</h2>
                <p>
                    <code>UNION</code> junta resultados de dois SELECTs (removendo repetidos), <code>UNION ALL</code> junta
                    mantendo repetidos (é mais rápido), <code>INTERSECT</code> traz o que está nos dois e <code>EXCEPT</code>
                    o que está no primeiro mas não no segundo.
                </p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
-- Alunos matriculados em Banco de Dados (1) MAS NÃO em Python (2)
SELECT aluno_id FROM matricula WHERE curso_id = 1
EXCEPT
SELECT aluno_id FROM matricula WHERE curso_id = 2
ORDER BY aluno_id;
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' %}{% block out -%}
+----------+
| aluno_id |
+----------+
|        2 |
|        5 |
+----------+
{%- endblock %}{% endembed %}
                <p>
                    Uma <strong>VIEW</strong> é uma consulta salva com nome, que você usa como se fosse uma tabela. Ela não
                    guarda dados: toda vez que você consulta a view, a consulta original roda de novo.
                </p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
CREATE VIEW boletim AS
SELECT a.nome AS aluno, c.nome AS curso, m.nota
FROM matricula m
JOIN aluno a ON a.id = m.aluno_id
JOIN curso c ON c.id = m.curso_id;

SELECT * FROM boletim WHERE nota >= 8;
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' %}{% block out -%}
+-----------+----------------+------+
| aluno     | curso          | nota |
+-----------+----------------+------+
| Ana Souza | Banco de Dados |  9.5 |
| Ana Souza | Python         |  8.0 |
+-----------+----------------+------+
{%- endblock %}{% endembed %}
            </div>

            <div class="card guia">
                <h2>4. Índices e desempenho</h2>
                {% embed 'partials/guide/box.twig' with {tipo: 'analogia'} %}{% block body %}
                    <p>
                        Um <strong>índice</strong> é o índice remissivo no fim de um livro: em vez de ler o livro inteiro
                        procurando "transação", você vai direto na página. Sem índice, o banco lê a tabela inteira
                        (<em>full scan</em>).
                    </p>
                {% endblock %}{% endembed %}
                <ul>
                    <li>Crie índice nas colunas usadas em <code>WHERE</code>, <code>JOIN ... ON</code> e <code>ORDER BY</code> de consultas frequentes.</li>
                    <li>Chave primária e <code>UNIQUE</code> já criam índice automaticamente.</li>
                    <li>Índice tem custo: ocupa espaço e deixa <code>INSERT</code>/<code>UPDATE</code> um pouco mais lentos. Não indexe tudo.</li>
                    <li><strong>Índice composto</strong> <code>(cidade, nome)</code> serve pra filtros por <code>cidade</code> e por <code>cidade + nome</code>, mas não só por <code>nome</code>. A ordem das colunas importa.</li>
                    <li><strong>Função na coluna atrapalha o índice</strong>: <code>WHERE YEAR(nascimento) = 2003</code> não usa o índice de <code>nascimento</code>. Prefira <code>WHERE nascimento &gt;= '2003-01-01' AND nascimento &lt; '2004-01-01'</code>.</li>
                </ul>
                <p><code>EXPLAIN</code> mostra o plano: como o banco pretende executar a consulta (não é padrão ANSI, mas quase todo banco tem):</p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
CREATE INDEX idx_aluno_cidade ON aluno (cidade);

EXPLAIN SELECT nome FROM aluno WHERE cidade = 'Recife';
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' with {compare: false, titulo: 'Resultado (resumido) — repare na coluna key'} %}{% block out -%}
+----+-------------+-------+------+------------------+------------------+------+-------+
| id | select_type | table | type | possible_keys    | key              | rows | Extra |
+----+-------------+-------+------+------------------+------------------+------+-------+
|  1 | SIMPLE      | aluno | ref  | idx_aluno_cidade | idx_aluno_cidade |    2 | NULL  |
+----+-------------+-------+------+------------------+------------------+------+-------+
{%- endblock %}{% endembed %}
                <p>
                    <code>key = idx_aluno_cidade</code> e <code>type = ref</code> mostram que o índice foi usado. Se aparecer
                    <code>type = ALL</code>, o banco está lendo a tabela inteira.
                </p>
            </div>

            <div class="card guia">
                <h2>5. Concorrência: níveis de isolamento</h2>
                <p>
                    Quando muitas pessoas usam o banco ao mesmo tempo, uma transação pode "enxergar" mudanças de outra em
                    momentos estranhos. O padrão SQL define quatro níveis de isolamento. Quanto mais alto, mais seguro e
                    mais lento:
                </p>
                <table>
                    <thead><tr><th>Nível</th><th>Leitura suja</th><th>Leitura não repetível</th><th>Fantasma</th></tr></thead>
                    <tbody>
                        <tr><td><code>READ UNCOMMITTED</code></td><td>pode</td><td>pode</td><td>pode</td></tr>
                        <tr><td><code>READ COMMITTED</code> <span class="text-xs text-slate-500">(padrão no PostgreSQL, SQL Server, Oracle)</span></td><td>não</td><td>pode</td><td>pode</td></tr>
                        <tr><td><code>REPEATABLE READ</code> <span class="text-xs text-slate-500">(padrão no MySQL/InnoDB)</span></td><td>não</td><td>não</td><td>pode*</td></tr>
                        <tr><td><code>SERIALIZABLE</code></td><td>não</td><td>não</td><td>não</td></tr>
                    </tbody>
                </table>
                <ul>
                    <li><strong>Leitura suja</strong>: ler um dado que outra transação ainda não confirmou (e que pode ser desfeito).</li>
                    <li><strong>Leitura não repetível</strong>: ler a mesma linha duas vezes e ver valores diferentes, porque alguém alterou no meio.</li>
                    <li><strong>Fantasma</strong>: repetir uma consulta e aparecerem linhas novas que alguém inseriu no meio.</li>
                </ul>
                <p class="text-xs text-slate-500">* O InnoDB do MySQL evita a maioria dos fantasmas no REPEATABLE READ usando travas de intervalo (<em>gap locks</em>).</p>
            </div>

            <div class="card guia">
                <h2>6. A lógica de três valores do NULL</h2>
                <p>
                    Com NULL, uma condição pode ser <strong>verdadeira</strong>, <strong>falsa</strong> ou
                    <strong>desconhecida</strong>. O <code>WHERE</code> só deixa passar o que é verdadeiro. Isso gera uma
                    pegadinha famosa com <code>NOT IN</code>:
                </p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
-- "Cursos cujo id não está na lista (1, NULL)": parece que deveria trazer 2, 3 e 4...
SELECT nome FROM curso WHERE id NOT IN (1, NULL);
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' with {titulo: 'Resultado: nenhuma linha (o console mostra o resultado vazio)'} %}{% block out -%}

{%- endblock %}{% endembed %}
                <p>
                    <code>2 NOT IN (1, NULL)</code> vira "2 ≠ 1 <em>e</em> 2 ≠ NULL", e "2 ≠ NULL" é desconhecido. Então a
                    condição inteira fica desconhecida e nada passa. Se uma subconsulta dentro de um <code>NOT IN</code> puder
                    devolver NULL, use <code>NOT EXISTS</code>:
                </p>
                {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true} %}{% block code -%}
-- Cursos sem nenhuma matrícula com nota abaixo de 7
SELECT c.nome
FROM curso c
WHERE NOT EXISTS (
    SELECT 1 FROM matricula m
    WHERE m.curso_id = c.id AND m.nota < 7
)
ORDER BY c.nome;
{%- endblock %}{% endembed %}
                {% embed 'partials/guide/output.twig' %}{% block out -%}
+--------+
| nome   |
+--------+
| Excel  |
| Python |
+--------+
{%- endblock %}{% endembed %}
            </div>

            <div class="card guia">
                <h2>✍️ Exercícios</h2>
                <details>
                    <summary>1. Para cada aluno, mostre a nota mais alta dele e em qual curso foi (use ROW_NUMBER).</summary>
                    {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true, titulo: 'Resposta'} %}{% block code -%}
WITH ranking AS (
    SELECT m.aluno_id, m.curso_id, m.nota,
           ROW_NUMBER() OVER (PARTITION BY m.aluno_id ORDER BY m.nota DESC) AS rn
    FROM matricula m
    WHERE m.nota IS NOT NULL
)
SELECT a.nome AS aluno, c.nome AS curso, r.nota
FROM ranking r
JOIN aluno a ON a.id = r.aluno_id
JOIN curso c ON c.id = r.curso_id
WHERE r.rn = 1
ORDER BY a.nome;
{%- endblock %}{% endembed %}
                    {% embed 'partials/guide/output.twig' %}{% block out -%}
+------------+----------------+------+
| aluno      | curso          | nota |
+------------+----------------+------+
| Ana Souza  | Banco de Dados |  9.5 |
| Bruno Lima | Banco de Dados |  6.5 |
| Elisa Melo | Banco de Dados |  7.0 |
+------------+----------------+------+
{%- endblock %}{% endembed %}
                </details>
                <details>
                    <summary>2. Gere os números de 1 a 5 com uma CTE recursiva.</summary>
                    {% embed 'partials/guide/code.twig' with {engine: 'mysql', console: true, titulo: 'Resposta'} %}{% block code -%}
WITH RECURSIVE numeros AS (
    SELECT 1 AS n
    UNION ALL
    SELECT n + 1 FROM numeros WHERE n < 5
)
SELECT n FROM numeros;
{%- endblock %}{% endembed %}
                    {% embed 'partials/guide/output.twig' %}{% block out -%}
+---+
| n |
+---+
| 1 |
| 2 |
| 3 |
| 4 |
| 5 |
+---+
{%- endblock %}{% endembed %}
                </details>
            </div>
