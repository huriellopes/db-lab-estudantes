              dim_tempo (dia, mes, ano, trimestre)
                         │
dim_produto ── fato_vendas (tempo_id, produto_id, loja_id, quantidade, valor) ── dim_loja
(nome, categoria)                                                                 (cidade, regiao)
{%- endblock %}{% endembed %}
