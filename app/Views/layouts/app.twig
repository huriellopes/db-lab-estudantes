<!doctype html>
<html lang="pt-br" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>{% if pageTitle is defined %}{{ pageTitle }} · {% endif %}{{ app_name }}</title>
    {{ vite() }}
</head>
<body class="h-full bg-slate-50" hx-boost="true">
<div class="min-h-full">
    <header class="border-b border-slate-200 bg-white" x-data="{ mobileOpen: false, accountOpen: false }">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
            <a href="/dashboard" class="flex items-center gap-2 text-lg font-semibold text-slate-900">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">DB</span>
                <span class="hidden sm:inline">{{ app_name }}</span>
            </a>

            <nav class="hidden items-center gap-1 text-sm font-medium text-slate-600 md:flex">
                {% include 'partials/nav-links.twig' with {mobile: false} %}
            </nav>

            <div class="flex items-center gap-2">
                <div class="relative hidden md:block" @click.outside="accountOpen = false">
                    <button
                        @click="accountOpen = !accountOpen" type="button"
                        class="flex items-center gap-2 rounded-lg py-1.5 pl-2 pr-3 text-sm hover:bg-slate-100"
                    >
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
                            {{ auth_user().name|slice(0, 1)|upper }}
                        </span>
                        <span class="whitespace-nowrap font-medium text-slate-700">{{ auth_user().shortName() }}</span>
                        <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                        </svg>
                    </button>
                    <div
                        x-show="accountOpen" x-cloak x-transition
                        class="absolute right-0 z-10 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg"
                    >
                        <div class="px-3 py-2">
                            <p class="text-sm font-medium text-slate-900">{{ auth_user().name }}</p>
                            <p class="text-xs text-slate-400">{{ auth_user().role.label() }}</p>
                        </div>
                        <div class="my-1 border-t border-slate-100"></div>
                        <a href="/profile" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Meu perfil</a>
                        <form method="post" action="/logout">
                            {{ csrf_field() }}
                            <button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-sm text-red-600 hover:bg-red-50">Sair</button>
                        </form>
                    </div>
                </div>

                <button
                    @click="mobileOpen = !mobileOpen" type="button" aria-label="Abrir menu"
                    class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 md:hidden"
                >
                    <svg x-show="!mobileOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
                    </svg>
                    <svg x-show="mobileOpen" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        <div x-show="mobileOpen" x-cloak x-transition class="border-t border-slate-200 md:hidden">
            <nav class="flex flex-col gap-1 px-4 py-3 text-sm font-medium text-slate-600">
                {% include 'partials/nav-links.twig' with {mobile: true} %}
                <div class="my-1 border-t border-slate-100"></div>
                <div class="px-3 py-1">
                    <p class="text-sm font-medium text-slate-900">{{ auth_user().name }}</p>
                    <p class="text-xs text-slate-400">{{ auth_user().role.label() }}</p>
                </div>
                <a href="/profile" class="rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-900">Meu perfil</a>
                <form method="post" action="/logout">
                    {{ csrf_field() }}
                    <button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-red-600 hover:bg-red-50">Sair</button>
                </form>
            </nav>
        </div>
    </header>

    {% set maintenance = is_admin() ? maintenance_mode() : null %}
    {% if maintenance %}
        <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-sm text-amber-800">
            <form method="post" action="/admin/manutencao/modo" class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
                {{ csrf_field() }}
                <input type="hidden" name="enabled" value="0">
                <span>Modo manutenção ativo{% if maintenance.since %} desde {{ maintenance.since|date('d/m H:i') }}{% endif %} — só admins acessam o lab.</span>
                <button type="submit" class="rounded-md bg-amber-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-amber-700">Desligar agora</button>
            </form>
        </div>
    {% endif %}

    <main class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
        {% include 'partials/flash.twig' %}
        {% block content %}{% endblock %}
    </main>

    {% include 'partials/credits.twig' with { class: 'border-t border-slate-200 px-4 py-6' } %}
</div>
{% include 'partials/toaster.twig' %}
{% include 'partials/confirm-modal.twig' %}
</body>
</html>
