{% extends 'layouts/app.twig' %}
{% import 'macros/table_controls.twig' as tc %}

{% block content %}
    {% set user = auth_user() %}

    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Olá, {{ user.name }} 👋</h1>
        <p class="mt-1 text-sm text-slate-500">Gerencie seus schemas (databases) de estudo.</p>
    </div>

    <div class="mb-6 flex items-start gap-3 rounded-2xl border border-indigo-100 bg-indigo-50/60 p-5 text-sm text-indigo-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
            Seu login MySQL (usado também no phpMyAdmin) é
            <code class="rounded bg-white px-1.5 py-0.5 font-mono text-indigo-700">{{ user.mysqlLogin }}</code>,
            com a mesma senha da sua conta aqui na plataforma.
            {% if pmaUrl %}
                <a href="{{ pmaUrl }}" target="_blank" rel="noopener" class="font-medium text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
                    Abrir phpMyAdmin →
                </a>
                ou
            {% endif %}
            <a href="/conectar" class="font-medium text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
                conectar por um SGBD local →
            </a>
        </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-5">
        <div class="card h-fit sm:col-span-2">
            <h2 class="mb-1 text-base font-semibold text-slate-900">Criar novo schema</h2>
            <p class="mb-4 text-sm text-slate-500">Use apenas letras, números e "_".</p>

            <form method="post" action="/schemas" class="space-y-4">
                {{ csrf_field() }}
                <div>
                    <label for="label" class="field-label">Nome do schema</label>
                    <div class="flex items-stretch overflow-hidden rounded-lg border border-slate-300 bg-white focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-100">
                        <span class="flex items-center whitespace-nowrap border-r border-slate-200 bg-slate-50 pl-3 pr-1 text-sm text-slate-400">
                            {{ user.mysqlLogin }}__
                        </span>
                        <input
                            type="text" id="label" name="label" pattern="[A-Za-z0-9_]{1,40}" maxlength="40" required
                            placeholder="biologia_2026"
                            class="w-full border-0 bg-transparent px-2 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0"
                        >
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">Sem espaços. O prefixo evita conflito com schemas de outras pessoas.</p>
                </div>
                <button type="submit" class="btn-primary w-full">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                    </svg>
                    Criar schema
                </button>
            </form>
        </div>

        <div class="card sm:col-span-3">
            <h2 class="mb-4 text-base font-semibold text-slate-900">Meus schemas</h2>

            {% if paginator.total == 0 and query.search == '' %}
                <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
                    <svg class="mx-auto mb-2 h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"/>
                    </svg>
                    <p class="text-sm text-slate-500">Você ainda não criou nenhum schema.</p>
                </div>
            {% else %}
                {{ tc.search_form('/dashboard', query, 'Buscar schema…', 'my-schemas-results') }}

                <div id="my-schemas-results">
                {% if paginator.items is empty %}
                    {{ tc.empty_search_state('/dashboard', query, 'schema') }}
                {% else %}
                <ul class="divide-y divide-slate-100">
                    {% for schema in paginator.items %}
                        <li data-row class="flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <div class="min-w-0">
                                <p class="truncate font-mono text-sm text-slate-800">{{ schema.dbName }}</p>
                                <p class="text-xs text-slate-400">Criado em {{ schema.createdAt|date('d/m/Y') }} às {{ schema.createdAt|date('H:i') }}</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                {% if pmaUrl %}
                                    <a
                                        href="{{ pmaUrl }}/index.php?route=/database/structure&db={{ schema.dbName|url_encode }}"
                                        target="_blank" rel="noopener" class="btn-secondary !px-3 !py-1.5 text-xs"
                                    >
                                        Abrir
                                    </a>
                                {% endif %}
                                <form
                                    hx-boost="false" x-data="ajaxForm({
                                        confirmTitle: 'Excluir schema',
                                        confirmMessage: 'Excluir o schema \'{{ schema.dbName|e('js') }}\'? Essa ação não pode ser desfeita.',
                                        confirmLabel: 'Excluir',
                                        removeRow: true,
                                    })"
                                    @submit.prevent="submit"
                                    method="post" action="/schemas/delete"
                                >
                                    {{ csrf_field() }}
                                    <input type="hidden" name="db_name" value="{{ schema.dbName }}">
                                    <button :disabled="loading" type="submit" class="btn-danger !px-3 !py-1.5 text-xs">
                                        <span x-show="!loading">Excluir</span>
                                        <span x-show="loading" x-cloak>Excluindo…</span>
                                    </button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                {{ tc.pagination('/dashboard', paginator, query) }}
                {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card mt-6">
        <h2 class="mb-1 text-base font-semibold text-slate-900">Console SQL</h2>
        <p class="mb-4 text-sm text-slate-500">Rode comandos SQL direto no seu schema, sem precisar de nenhum SGBD.</p>

        <div
            x-data="sqlConsole('{{ schemaNames is empty ? '' : schemaNames[0]|e('js') }}', {{ schemaNames|json_encode }})"
            class="space-y-4"
        >
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <label for="sql_schema" class="field-label mb-0 shrink-0">Schema</label>
                <select id="sql_schema" x-model="schema" class="field-input font-mono text-xs sm:max-w-xs">
                    <option value="">— nenhum —</option>
                    <template x-for="name in schemas" :key="name">
                        <option :value="name" x-text="name"></option>
                    </template>
                </select>
            </div>

            <p class="text-xs text-slate-500" x-show="!schema" x-cloak>
                Sem schema selecionado: dá pra criar o primeiro rodando algo como
                <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">CREATE DATABASE {{ user.mysqlLogin }}__meu_schema;</code>
                aqui embaixo — o nome precisa começar com <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{{ user.mysqlLogin }}__</code>.
                Ele aparece na lista acima assim que for criado.
            </p>

            <div>
                <textarea
                    x-ref="sqlInput" x-model="sql" rows="6" spellcheck="false"
                    placeholder="SELECT * FROM minha_tabela;"
                    class="field-input font-mono text-sm"
                    @keydown.ctrl.enter="run" @keydown.meta.enter="run"
                    @select="trackSelection" @mouseup="trackSelection" @keyup="trackSelection" @blur="trackSelection"
                ></textarea>
                <p class="mt-1.5 text-xs text-slate-500">
                    <template x-if="hasSelection">
                        <span>Vai rodar só o trecho selecionado. Clique fora da seleção pra rodar tudo de novo.</span>
                    </template>
                    <template x-if="!hasSelection">
                        <span>
                            Ctrl+Enter (ou ⌘+Enter) roda direto. Selecione um trecho pra rodar só ele — sem seleção,
                            roda tudo. Vários comandos? Separe com ";", cada um roda em sequência e para no primeiro erro.
                        </span>
                    </template>
                </p>
            </div>

            <div class="flex items-center gap-2">
                <button :disabled="loading" @click="run" type="button" class="btn-primary">
                    <svg x-show="!loading" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z"/>
                    </svg>
                    <span x-show="!loading" x-text="hasSelection ? 'Executar seleção' : 'Executar tudo'"></span>
                    <span x-show="loading" x-cloak>Executando…</span>
                </button>
                <button @click="clear" type="button" class="btn-secondary" :disabled="loading">Limpar</button>
            </div>

            <template x-if="summary">
                <div
                    class="rounded-lg border px-4 py-3 text-sm"
                    :class="summary.ok ? 'border-emerald-100 bg-emerald-50 text-emerald-700' : 'border-red-100 bg-red-50 text-red-700'"
                    x-text="summary.message"
                ></div>
            </template>

            <template x-for="(result, i) in results" :key="i">
                <div class="overflow-hidden rounded-lg border border-slate-200">
                    <div class="border-b border-slate-100 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-500" x-text="result.sql"></div>

                    <template x-if="result.type === 'write'">
                        <p class="px-3 py-3 text-sm text-slate-600">
                            <span x-text="result.affected"></span> linha(s) afetada(s).
                        </p>
                    </template>

                    <template x-if="result.type === 'rows'">
                        <div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs">
                                    <thead>
                                        <tr class="border-b border-slate-100 text-slate-400">
                                            <template x-for="col in result.columns" :key="col">
                                                <th class="px-3 py-2 font-medium" x-text="col"></th>
                                            </template>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <template x-for="(row, ri) in result.rows" :key="ri">
                                            <tr>
                                                <template x-for="col in result.columns" :key="col">
                                                    <td class="px-3 py-2 font-mono text-slate-700" x-text="row[col] === null ? 'NULL' : row[col]"></td>
                                                </template>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                            <p x-show="result.rows.length === 0" class="px-3 py-3 text-sm text-slate-400">Nenhuma linha retornada.</p>
                            <p x-show="result.truncated" class="border-t border-slate-100 px-3 py-2 text-xs text-amber-600">
                                Mostrando as primeiras <span x-text="result.rows.length"></span> de <span x-text="result.total"></span> linhas.
                            </p>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </div>
{% endblock %}
