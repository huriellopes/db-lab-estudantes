{% extends 'layouts/app.twig' %}

{% block content %}
    {% set user = auth_user() %}

    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Olá, {{ user.name }} 👋</h1>
        <p class="mt-1 text-sm text-slate-500">Gerencie seus schemas (databases) de estudo.</p>
    </div>

    <div class="mb-6 flex items-start gap-3 rounded-2xl border border-indigo-100 bg-indigo-50/60 p-5 text-sm text-indigo-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
            Seu login MySQL (usado também no phpMyAdmin) é
            <code class="rounded bg-white px-1.5 py-0.5 font-mono text-indigo-700">{{ user.mysqlLogin }}</code>,
            com a mesma senha da sua conta aqui na plataforma.
            <a href="{{ pmaUrl }}" target="_blank" rel="noopener" class="font-medium text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
                Abrir phpMyAdmin →
            </a>
            ou
            <a href="/conectar" class="font-medium text-indigo-700 underline underline-offset-2 hover:text-indigo-900">
                conectar por um SGBD local →
            </a>
        </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-5">
        <div class="card h-fit sm:col-span-2">
            <h2 class="mb-1 text-base font-semibold text-slate-900">Criar novo schema</h2>
            <p class="mb-4 text-sm text-slate-500">Use apenas letras, números e "_".</p>

            <form method="post" action="/schemas" class="space-y-4">
                <div>
                    <label for="label" class="field-label">Nome do schema</label>
                    <div class="flex items-stretch overflow-hidden rounded-lg border border-slate-300 bg-white focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-100">
                        <span class="flex items-center whitespace-nowrap border-r border-slate-200 bg-slate-50 pl-3 pr-1 text-sm text-slate-400">
                            {{ user.mysqlLogin }}__
                        </span>
                        <input
                            type="text" id="label" name="label" pattern="[A-Za-z0-9_]{1,40}" maxlength="40" required
                            placeholder="biologia_2026"
                            class="w-full border-0 bg-transparent px-2 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-0"
                        >
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">Sem espaços. O prefixo evita conflito com schemas de outras pessoas.</p>
                </div>
                <button type="submit" class="btn-primary w-full">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                    </svg>
                    Criar schema
                </button>
            </form>
        </div>

        <div class="card sm:col-span-3">
            <h2 class="mb-4 text-base font-semibold text-slate-900">Meus schemas</h2>

            {% if schemas is empty %}
                <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
                    <svg class="mx-auto mb-2 h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"/>
                    </svg>
                    <p class="text-sm text-slate-500">Você ainda não criou nenhum schema.</p>
                </div>
            {% else %}
                <ul class="divide-y divide-slate-100">
                    {% for schema in schemas %}
                        <li data-row class="flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <div class="min-w-0">
                                <p class="truncate font-mono text-sm text-slate-800">{{ schema.dbName }}</p>
                                <p class="text-xs text-slate-400">Criado em {{ schema.createdAt|date('d/m/Y') }} às {{ schema.createdAt|date('H:i') }}</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                <a
                                    href="{{ pmaUrl }}/index.php?route=/database/structure&db={{ schema.dbName|url_encode }}"
                                    target="_blank" rel="noopener" class="btn-secondary !px-3 !py-1.5 text-xs"
                                >
                                    Abrir
                                </a>
                                <form
                                    x-data="ajaxForm({
                                        confirmTitle: 'Excluir schema',
                                        confirmMessage: 'Excluir o schema \'{{ schema.dbName }}\'? Essa ação não pode ser desfeita.',
                                        confirmLabel: 'Excluir',
                                        removeRow: true,
                                    })"
                                    @submit.prevent="submit"
                                    method="post" action="/schemas/delete"
                                >
                                    <input type="hidden" name="db_name" value="{{ schema.dbName }}">
                                    <button :disabled="loading" type="submit" class="btn-danger !px-3 !py-1.5 text-xs">
                                        <span x-show="!loading">Excluir</span>
                                        <span x-show="loading" x-cloak>Excluindo…</span>
                                    </button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
{% endblock %}
