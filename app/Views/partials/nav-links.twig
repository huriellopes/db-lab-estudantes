{# Menu principal. No desktop os itens ficam agrupados em dropdowns (Estudar / Ensino / Admin):
   com 7+ links soltos o header estourava entre 768 e 1024px (tablet e notebook pequeno). No
   mobile os mesmos grupos viram seções da lista. #}
{% set mobile = mobile|default(false) %}
{% set linkClass = mobile ? 'rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-900' : 'whitespace-nowrap rounded-lg px-3 py-1.5 hover:bg-slate-100 hover:text-slate-900' %}

{% macro group(label, links, linkClass, mobile) %}
    {% if mobile %}
        <p class="mb-1 mt-3 px-3 text-xs font-semibold uppercase tracking-wide text-slate-400">{{ label }}</p>
        {% for link in links %}
            <a href="{{ link.href }}" class="{{ linkClass }}">{{ link.label }}</a>
        {% endfor %}
    {% else %}
        <div class="relative" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
            <button @click="open = !open" type="button" class="flex items-center gap-1 {{ linkClass }}" :aria-expanded="open">
                {{ label }}
                <svg class="h-3.5 w-3.5 text-slate-400 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>
            <div
                x-show="open" x-cloak x-transition @click="open = false"
                class="absolute left-0 z-20 mt-2 w-52 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg"
            >
                {% for link in links %}
                    <a href="{{ link.href }}" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">{{ link.label }}</a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endmacro %}
{% import _self as nav %}

<a href="/dashboard" class="{{ linkClass }}">Meu painel</a>

{{ nav.group('Estudar', [
    { href: '/guia', label: 'Guia' },
    { href: '/laboratorio/modelagem', label: 'Laboratório' },
    { href: '/conectar', label: 'Conectar' },
], linkClass, mobile) }}

{% if can_manage_students() %}
    {{ nav.group('Ensino', [
        { href: '/professor/alunos', label: 'Alunos' },
        { href: '/turmas', label: 'Turmas' },
        { href: '/professor/bancos', label: 'Bancos dos alunos' },
    ], linkClass, mobile) }}
{% endif %}

{% if is_admin() %}
    {{ nav.group(mobile ? 'Administração' : 'Admin', [
        { href: '/admin', label: 'Visão geral' },
        { href: '/admin/usuarios', label: 'Usuários' },
        { href: '/admin/instituicoes', label: 'Instituições' },
        { href: '/admin/schemas', label: 'Schemas' },
        { href: '/admin/auditoria', label: 'Auditoria' },
        { href: '/admin/logs', label: 'Logs de erro' },
        { href: '/admin/logs/ao-vivo', label: 'Logs ao vivo' },
        { href: '/admin/backups', label: 'Backups' },
        { href: '/admin/excluidos', label: 'Dados excluídos' },
        { href: '/admin/manutencao', label: 'Manutenção' },
    ], linkClass, mobile) }}
{% endif %}
