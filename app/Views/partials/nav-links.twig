{% set mobile = mobile|default(false) %}
{% set linkClass = mobile ? 'rounded-lg px-3 py-2 hover:bg-slate-100 hover:text-slate-900' : 'rounded-lg px-3 py-1.5 hover:bg-slate-100 hover:text-slate-900' %}

<a href="/dashboard" class="{{ linkClass }}">Meu painel</a>
<a href="/conectar" class="{{ linkClass }}">Conectar</a>
<a href="/guia" class="{{ linkClass }}">Guia</a>
<a href="/laboratorio/modelagem" class="{{ linkClass }}">Laboratório</a>
{% if can_manage_students() %}
    <a href="/professor/alunos" class="{{ linkClass }}">Alunos</a>
{% endif %}
{% if is_admin() %}
    {% if mobile %}
        <p class="mb-1 mt-3 px-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Administração</p>
        <a href="/admin" class="{{ linkClass }}">Visão geral</a>
        <a href="/admin/usuarios" class="{{ linkClass }}">Usuários</a>
        <a href="/admin/schemas" class="{{ linkClass }}">Schemas</a>
        <a href="/admin/auditoria" class="{{ linkClass }}">Auditoria</a>
        <a href="/admin/logs" class="{{ linkClass }}">Logs de erro</a>
        <a href="/admin/backups" class="{{ linkClass }}">Backups</a>
    {% else %}
        <div class="relative" x-data="{ open: false }" @click.outside="open = false">
            <button @click="open = !open" type="button" class="flex items-center gap-1 {{ linkClass }}">
                Admin
                <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>
            <div
                x-show="open" x-cloak x-transition
                class="absolute left-0 z-10 mt-2 w-48 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg"
            >
                <a href="/admin" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Visão geral</a>
                <a href="/admin/usuarios" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Usuários</a>
                <a href="/admin/schemas" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Schemas</a>
                <a href="/admin/auditoria" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Auditoria</a>
                <a href="/admin/logs" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Logs de erro</a>
                <a href="/admin/backups" class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">Backups</a>
            </div>
        </div>
    {% endif %}
{% endif %}
