{# Espera 'topics' (App\Support\GuideTopics::ALL) e 'currentSlug' no contexto. #}
<div class="mb-6">
    <a href="/guia" class="text-sm text-slate-500 hover:text-slate-700">← Guia</a>
</div>

<div class="mb-8 flex flex-wrap gap-2">
    {% for slug, topic in topics %}
        <a
            href="/guia/{{ slug }}"
            class="{{ slug == currentSlug ? 'badge-indigo' : 'badge-slate' }} hover:opacity-80"
        >{{ topic.icon }} {{ topic.title }}</a>
    {% endfor %}
</div>
