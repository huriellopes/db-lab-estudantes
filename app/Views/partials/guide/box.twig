{#
    Quadro de destaque do guia, via embed com o conteúdo no block "body":
      tipo: 'dica' (padrão), 'atencao', 'analogia' ou 'lab' (como fazer neste laboratório).
      titulo: opcional, substitui o título padrão do tipo.
#}
{% set estilos = {
    dica: {cor: 'border-sky-200 bg-sky-50/70 text-sky-950', icone: '💡', titulo: 'Dica'},
    atencao: {cor: 'border-amber-200 bg-amber-50/70 text-amber-950', icone: '⚠️', titulo: 'Atenção'},
    analogia: {cor: 'border-violet-200 bg-violet-50/70 text-violet-950', icone: '🧠', titulo: 'Pense assim'},
    lab: {cor: 'border-indigo-200 bg-indigo-50/70 text-indigo-950', icone: '🧪', titulo: 'No laboratório'},
} %}
{% set estilo = estilos[tipo|default('dica')] %}
<div class="my-4 rounded-xl border p-4 text-sm leading-relaxed {{ estilo.cor }}">
    <p class="mb-1 font-semibold">{{ estilo.icone }} {{ titulo|default(estilo.titulo) }}</p>
    <div class="space-y-2">{% block body %}{% endblock %}</div>
</div>
