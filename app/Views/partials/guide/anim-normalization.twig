{# Animação: a planilha virando tabelas normalizadas (Alpine normalizationSteps). Dados = lojinha do guia. #}
<figure x-data="normalizationSteps" class="my-4 space-y-4 rounded-xl border border-indigo-200 bg-white p-4">
    <figcaption class="flex flex-wrap items-center justify-between gap-2">
        <span class="text-sm font-semibold text-indigo-900">🎞️ Da planilha à 3FN, passo a passo</span>
        <span class="flex flex-wrap gap-1" role="tablist" aria-label="Etapa">
            <template x-for="(s, i) in steps" :key="s.label">
                <button type="button" role="tab" @click="go(i)" :aria-selected="step === i"
                    :class="step === i ? 'bg-indigo-600 text-white' : (i < step ? 'bg-indigo-100 text-indigo-800' : 'bg-slate-100 text-slate-700 hover:bg-slate-200')"
                    class="rounded-full px-3 py-1 text-xs font-medium" x-text="s.label"></button>
            </template>
        </span>
    </figcaption>

    <div>
        <p class="text-sm font-semibold text-slate-900" x-text="current.title"></p>
        <p class="mt-1 text-sm text-slate-700" aria-live="polite" x-text="current.text"></p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
        <template x-for="t in current.tables" :key="current.label + t.name">
            <div class="guide-pop" :class="current.tables.length === 1 && 'md:col-span-2'">
                <p class="mb-1 font-mono text-xs font-semibold text-slate-600" x-text="t.name"></p>
                <table>
                    <thead>
                        <tr>
                            <template x-for="c in t.columns" :key="c">
                                <th :class="t.warn.includes(c) && 'bg-amber-100 text-amber-900'">
                                    <span x-show="t.key.includes(c)" title="Chave">🔑</span>
                                    <span x-text="c"></span>
                                </th>
                            </template>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(row, r) in t.rows" :key="r">
                            <tr>
                                <template x-for="(cell, c) in row" :key="c">
                                    <td :class="t.warn.includes(t.columns[c]) && 'bg-amber-50 text-amber-900'" x-text="cell"></td>
                                </template>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </template>
    </div>

    <p class="text-xs text-slate-500"><span class="rounded bg-amber-100 px-1 text-amber-900">amarelo</span> = o problema que o próximo passo resolve · 🔑 = chave primária</p>
    {% include 'partials/guide/anim-controls.twig' %}
</figure>
