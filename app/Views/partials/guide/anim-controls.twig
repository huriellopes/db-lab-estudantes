{# Botões comuns das animações do guia (ver resources/js/guide-animations.js, função stepper). #}
<div class="flex flex-wrap items-center gap-2 text-sm">
    <button type="button" @click="prev()" :disabled="step === 0" class="btn-secondary px-3 py-1.5 disabled:opacity-40">◀ Voltar</button>
    <button type="button" @click="next()" :disabled="atEnd" class="btn-primary px-3 py-1.5 disabled:opacity-40">▶ Próximo</button>
    <button type="button" @click="playing ? pause() : play()" class="btn-secondary px-3 py-1.5" x-text="playing ? '⏸ Pausar' : '⏵ Rodar sozinho'"></button>
    <button type="button" @click="restart()" :disabled="step === 0" class="rounded-lg px-3 py-1.5 text-slate-500 hover:bg-slate-100 disabled:opacity-40">↺ Recomeçar</button>
    <span class="ml-auto text-xs text-slate-500" x-text="`Passo ${step} de ${total}`"></span>
</div>
