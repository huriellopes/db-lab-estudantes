{% set flash = flash() %}
{% if flash %}
    <div
        x-data="flashMessage"
        x-show="visible"
        x-transition.opacity.duration.300ms
        class="mb-6 flex items-start gap-2 rounded-xl border px-4 py-3 text-sm {{ flash.type.isSuccess() ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-red-200 bg-red-50 text-red-700' }}"
    >
        {% if flash.type.isSuccess() %}
            <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25L15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {% else %}
            <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.007M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {% endif %}
        <span>{{ flash.message }}</span>
    </div>
{% endif %}
