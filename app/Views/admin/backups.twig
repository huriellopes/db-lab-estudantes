{% extends 'layouts/app.twig' %}

{% block content %}
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Backups</h1>
        <p class="mt-1 text-sm text-slate-500">
            Dumps <code>.sql.gz</code> do banco da aplicação ou de um schema. Ficam os {{ keepLast }} mais recentes.
            Para restaurar, importe o arquivo pelo phpMyAdmin ou com <code>gunzip &lt; arquivo.sql.gz | mysql</code>.
        </p>
    </div>

    {# Form clássico (redirect + flash): a lista abaixo precisa recarregar com o arquivo novo. #}
    <form
        x-data="{ loading: false }" @submit="loading = true"
        method="post" action="/admin/backups" class="card mb-6 grid gap-3 sm:grid-cols-[1fr_auto]"
    >
        {{ csrf_field() }}
        <select name="database" class="field-input" required>
            {% for db in databases %}
                <option value="{{ db }}">{{ db }}{{ loop.first ? ' (aplicação)' : '' }}</option>
            {% endfor %}
        </select>
        <button :disabled="loading" type="submit" class="btn-primary">
            <span x-show="!loading">Gerar backup agora</span>
            <span x-show="loading" x-cloak>Gerando…</span>
        </button>
    </form>

    <div class="card">
        {% if backups is empty %}
            <p class="py-6 text-center text-sm text-slate-500">Nenhum backup gerado ainda.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                            <th class="py-2 pr-4">Arquivo</th>
                            <th class="py-2 pr-4">Tamanho</th>
                            <th class="py-2 pr-4">Gerado em</th>
                            <th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for b in backups %}
                            <tr data-row>
                                <td class="py-3 pr-4 font-mono text-slate-800">{{ b.name }}</td>
                                <td class="py-3 pr-4 text-slate-500">{{ b.size|bytes }}</td>
                                <td class="py-3 pr-4 text-slate-500">{{ b.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="py-3">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/admin/backups/{{ b.name }}" hx-boost="false" class="btn-secondary !px-3 !py-1.5 text-xs">Baixar</a>
                                        <form
                                            hx-boost="false" x-data="ajaxForm({
                                                confirmTitle: 'Excluir backup',
                                                confirmMessage: 'Excluir o backup \'{{ b.name|e('js') }}\'?',
                                                confirmLabel: 'Excluir',
                                                removeRow: true,
                                            })"
                                            @submit.prevent="submit"
                                            method="post" action="/admin/backups/{{ b.name }}/excluir"
                                        >
                                            {{ csrf_field() }}
                                            <button :disabled="loading" type="submit" class="btn-danger !px-3 !py-1.5 text-xs">Excluir</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
