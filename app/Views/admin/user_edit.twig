{% extends 'layouts/app.twig' %}
{% import 'macros/forms.twig' as forms %}

{% block content %}
    <div class="mb-8">
        <a href="/admin/usuarios" class="text-sm text-slate-500 hover:text-slate-700">← Voltar para usuários</a>
        <h1 class="mt-2 text-2xl font-semibold text-slate-900">Editar {{ user.name }}</h1>
        <span class="badge-indigo mt-2">{{ user.role.label() }}</span>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
        <div class="card h-fit">
            <h2 class="mb-4 text-base font-semibold text-slate-900">Dados da conta</h2>

            <form
                hx-boost="false" x-data="ajaxForm()" @submit.prevent="submit"
                method="post" action="/admin/usuarios/{{ user.id }}" class="space-y-4"
            >
                {{ csrf_field() }}
                <div>
                    <label for="name" class="field-label">Nome</label>
                    <input type="text" id="name" name="name" value="{{ user.name }}" required minlength="2" class="field-input">
                </div>
                <div>
                    <label for="email" class="field-label">E-mail</label>
                    <input type="email" id="email" name="email" value="{{ user.email }}" required class="field-input">
                </div>
                <button :disabled="loading" type="submit" class="btn-primary w-full">
                    <span x-show="!loading">Salvar</span>
                    <span x-show="loading" x-cloak>Salvando…</span>
                </button>
            </form>
        </div>

        <div class="card h-fit">
            <h2 class="mb-1 text-base font-semibold text-slate-900">Resetar senha</h2>
            <p class="mb-4 text-sm text-slate-500">Define uma nova senha para a conta (app + MySQL/phpMyAdmin).</p>

            <form
                hx-boost="false" x-data="ajaxForm({
                    confirmTitle: 'Resetar senha',
                    confirmMessage: 'Resetar a senha de {{ user.name|e('js') }}? A senha atual dela para de funcionar imediatamente (app e MySQL/phpMyAdmin).',
                    confirmLabel: 'Resetar senha',
                    onSuccess: () => $el.reset(),
                })"
                @submit.prevent="submit"
                method="post" action="/admin/usuarios/{{ user.id }}/senha" class="space-y-4"
            >
                {{ csrf_field() }}
                {{ forms.password_field('new_password', 'new_password', 'Nova senha', password_min_length) }}
                <button :disabled="loading" type="submit" class="btn-secondary w-full">
                    <span x-show="!loading">Resetar senha</span>
                    <span x-show="loading" x-cloak>Atualizando…</span>
                </button>
            </form>
        </div>
    </div>
{% endblock %}
