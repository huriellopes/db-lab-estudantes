{% extends 'layouts/app.twig' %}

{% block content %}
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Auditoria</h1>
        <p class="mt-1 text-sm text-slate-500">Quem fez o quê, quando e de onde — logins, contas, papéis, schemas e backups.</p>
    </div>

    <div class="card">
        <form method="get" action="/admin/auditoria" class="mb-4 grid gap-3 sm:grid-cols-[1fr_auto_auto_auto]">
            <input type="search" name="q" value="{{ filters.q }}" placeholder="Buscar por pessoa, ação, alvo ou IP…" class="field-input">
            <select name="acao" class="field-input">
                <option value="">Todas as ações</option>
                {% for a in actions %}
                    <option value="{{ a }}" {{ a == filters.acao ? 'selected' }}>{{ a }}</option>
                {% endfor %}
            </select>
            <select name="dias" class="field-input">
                {% for d in periods %}
                    <option value="{{ d }}" {{ d == filters.dias ? 'selected' }}>Últimos {{ d }} dia{{ d == 1 ? '' : 's' }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn-primary">Filtrar</button>
        </form>

        {% if paginator.items is empty %}
            <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
                <p class="text-sm text-slate-500">Nenhum registro de auditoria nesse filtro.</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                            <th class="py-2 pr-4">Quando</th>
                            <th class="py-2 pr-4">Quem</th>
                            <th class="py-2 pr-4">Ação</th>
                            <th class="py-2 pr-4">Alvo</th>
                            <th class="py-2 pr-4">Detalhes</th>
                            <th class="py-2">IP</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for log in paginator.items %}
                            <tr>
                                <td class="whitespace-nowrap py-3 pr-4 text-slate-500">{{ log.created_at|date('d/m/Y H:i:s') }}</td>
                                <td class="py-3 pr-4 text-slate-800">{{ log.user_name ?? '—' }}{% if log.user_id %} <span class="text-xs text-slate-400">#{{ log.user_id }}</span>{% endif %}</td>
                                <td class="py-3 pr-4">
                                    <span class="{{ log.action ends with 'failed' or log.action ends with 'deleted' ? 'badge-rose' : 'badge-slate' }} font-mono">{{ log.action }}</span>
                                </td>
                                <td class="py-3 pr-4 font-mono text-xs text-slate-600">{{ log.target_type ? log.target_type ~ ':' ~ log.target_id : '—' }}</td>
                                <td class="py-3 pr-4 text-xs text-slate-500">
                                    {% for k, v in log.meta %}<span class="mr-2"><span class="text-slate-400">{{ k }}=</span>{{ v }}</span>{% endfor %}
                                </td>
                                <td class="py-3 font-mono text-xs text-slate-400">{{ log.ip }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-4 flex flex-col gap-3 border-t border-slate-100 pt-4 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
                <span>Mostrando {{ paginator.from() }}–{{ paginator.to() }} de {{ paginator.total }}</span>
                {% if paginator.lastPage() > 1 %}
                    <div class="flex items-center gap-2">
                        {% if paginator.hasPrevious() %}
                            <a href="/admin/auditoria?{{ filters|merge({ page: paginator.page - 1 })|url_encode }}" class="btn-secondary !px-3 !py-1.5 text-xs">← Anterior</a>
                        {% endif %}
                        <span class="px-1 text-xs text-slate-400">Página {{ paginator.page }} de {{ paginator.lastPage() }}</span>
                        {% if paginator.hasNext() %}
                            <a href="/admin/auditoria?{{ filters|merge({ page: paginator.page + 1 })|url_encode }}" class="btn-secondary !px-3 !py-1.5 text-xs">Próxima →</a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
