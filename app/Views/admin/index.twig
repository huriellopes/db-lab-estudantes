{% extends 'layouts/app.twig' %}

{% macro stat(label, value, hint = '') %}
    <div class="card">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">{{ label }}</p>
        <p class="mt-1 text-3xl font-semibold text-slate-900">{{ value }}</p>
        {% if hint %}<p class="mt-1 text-xs text-slate-500">{{ hint }}</p>{% endif %}
    </div>
{% endmacro %}

{% block content %}
    {% import _self as m %}

    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Administração</h1>
        <p class="mt-1 text-sm text-slate-500">Visão geral do lab — usuários, uso, saúde dos serviços e operação.</p>
    </div>

    {% include 'partials/health-card.twig' with { health: health, detailed: true, class: 'mb-8' } %}

    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Pessoas</h2>
    <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {{ m.stat('Alunos', stats.alunos) }}
        {{ m.stat('Professores', stats.professores) }}
        {{ m.stat('Admins', stats.admins) }}
        {{ m.stat('Ativos (7 dias)', stats.activeLast7Days, stats.activeLast30Days ~ ' nos últimos 30 dias') }}
        {{ m.stat('Nunca entraram', stats.neverLoggedIn, 'de ' ~ stats.totalUsers() ~ ' contas') }}
        {{ m.stat('Desativados', stats.inactiveUsers) }}
        {{ m.stat('Dados excluídos', stats.deletedBatches, 'lotes aguardando revisão') }}
        {{ m.stat('Erros (24h)', stats.errorsLast24h, 'ver logs de erro') }}
    </div>

    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Uso do lab</h2>
    <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {{ m.stat('Schemas', stats.schemas) }}
        {{ m.stat('Espaço em schemas', stats.schemasTotalBytes|bytes) }}
        {{ m.stat('Consultas salvas', stats.savedQueries) }}
        {{ m.stat('Diagramas ER', stats.erDiagrams) }}
    </div>

    <div class="mb-8 grid gap-6 lg:grid-cols-2">
        <div class="card">
            <h2 class="mb-4 text-base font-semibold text-slate-900">Cadastros — últimos 14 dias</h2>
            <div class="flex h-32 items-end gap-1" role="img" aria-label="Cadastros por dia nos últimos 14 dias">
                {% set max = stats.maxSignupsPerDay() %}
                {% for day in stats.signupsByDay %}
                    <div class="flex flex-1 flex-col items-center justify-end gap-1" title="{{ day.date|date('d/m') }}: {{ day.total }}">
                        <span class="text-[10px] text-slate-400">{{ day.total ?: '' }}</span>
                        <div class="w-full rounded-t bg-indigo-500" style="height: {{ (day.total / max * 100)|round }}%; min-height: 2px"></div>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-1 flex justify-between text-[10px] text-slate-400">
                <span>{{ stats.signupsByDay|first.date|date('d/m') }}</span>
                <span>hoje</span>
            </div>
        </div>
        <div class="card">
            <h2 class="mb-4 text-base font-semibold text-slate-900">Maiores schemas</h2>
            {% if stats.largestSchemas is empty %}
                <p class="text-sm text-slate-500">Nenhum schema criado ainda.</p>
            {% else %}
                <ul class="divide-y divide-slate-100 text-sm">
                    {% for s in stats.largestSchemas %}
                        <li class="flex items-center justify-between py-2">
                            <span class="font-mono text-slate-800">{{ s.dbName }} <span class="font-sans text-xs text-slate-400">· {{ s.ownerName }}</span></span>
                            <span class="text-slate-500">{{ s.bytes|bytes }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for link in [
            { href: '/admin/usuarios', title: 'Gerenciar usuários', text: 'Editar, trocar papel, resetar senha ou excluir qualquer conta.' },
            { href: '/admin/instituicoes', title: 'Instituições', text: 'Escolas e faculdades: professores, alunos e código de convite.' },
            { href: '/admin/schemas', title: 'Todos os schemas', text: 'Ver e excluir qualquer database criado no lab.' },
            { href: '/admin/auditoria', title: 'Auditoria', text: 'Quem fez o quê e quando — logins, papéis, exclusões, backups.' },
            { href: '/admin/logs', title: 'Logs de erro', text: 'Erros recentes da aplicação, agrupados por recorrência.' },
            { href: '/admin/logs/ao-vivo', title: 'Logs ao vivo', text: 'Acompanhe em tempo real (tail -f) os logs da aplicação, do MySQL e a auditoria.' },
            { href: '/admin/backups', title: 'Backups', text: 'Gerar e baixar dumps do banco da aplicação ou de um schema.' },
            { href: '/admin/excluidos', title: 'Dados excluídos', text: 'Restaure ou exclua definitivamente contas, schemas, consultas e diagramas excluídos.' },
            { href: '/admin/manutencao', title: 'Manutenção', text: 'Disco, memória e PHP em detalhe; limpar caches, liberar espaço e modo manutenção.' },
        ] %}
            <a href="{{ link.href }}" class="card flex items-center justify-between transition-shadow hover:shadow-md">
                <div>
                    <h2 class="text-base font-semibold text-slate-900">{{ link.title }}</h2>
                    <p class="mt-1 text-sm text-slate-500">{{ link.text }}</p>
                </div>
                <span class="text-slate-400">→</span>
            </a>
        {% endfor %}
    </div>
{% endblock %}
