{% extends 'layouts/app.twig' %}

{% block content %}
    {% set me = auth_user() %}

    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Usuários</h1>
            <p class="mt-1 text-sm text-slate-500">Todos os alunos, professores e admins do lab.</p>
        </div>
        <span class="badge-indigo">{{ users|length }} conta{{ users|length == 1 ? '' : 's' }}</span>
    </div>

    <div class="card">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                        <th class="py-2 pr-4 font-medium">Nome</th>
                        <th class="py-2 pr-4 font-medium">E-mail</th>
                        <th class="py-2 pr-4 font-medium">Papel</th>
                        <th class="py-2 pr-4 font-medium">Cadastrado em</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for user in users %}
                        <tr data-row>
                            <td class="py-3 pr-4 font-medium text-slate-800">{{ user.name }}</td>
                            <td class="py-3 pr-4 text-slate-500">{{ user.email }}</td>
                            <td class="py-3 pr-4">
                                {% if user.id == me.id %}
                                    <span class="badge-amber">{{ user.role.label() }} (você)</span>
                                {% else %}
                                    <form x-data="ajaxForm()" @change="submit" method="post" action="/admin/usuarios/{{ user.id }}/papel">
                                        <select name="role" :disabled="loading" class="field-input !w-auto !py-1.5 text-xs">
                                            {% for role in roles %}
                                                <option value="{{ role.value }}" {{ role == user.role ? 'selected' : '' }}>{{ role.label() }}</option>
                                            {% endfor %}
                                        </select>
                                    </form>
                                {% endif %}
                            </td>
                            <td class="py-3 pr-4 text-slate-500">{{ user.createdAt|date('d/m/Y') }}</td>
                            <td class="py-3">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/admin/usuarios/{{ user.id }}/editar" class="btn-secondary !px-3 !py-1.5 text-xs">Editar</a>
                                    {% if user.id != me.id %}
                                        <form
                                            x-data="ajaxForm({ confirmMessage: 'Excluir a conta de {{ user.name }}? Isso apaga também todos os schemas dela.', removeRow: true })"
                                            @submit.prevent="submit"
                                            method="post" action="/admin/usuarios/{{ user.id }}/excluir"
                                        >
                                            <button :disabled="loading" type="submit" class="btn-danger !px-3 !py-1.5 text-xs">
                                                <span x-show="!loading">Excluir</span>
                                                <span x-show="loading" x-cloak>Excluindo…</span>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
