{% extends 'layouts/app.twig' %}
{% import 'macros/table_controls.twig' as tc %}

{% block content %}
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Usuários</h1>
            <p class="mt-1 text-sm text-slate-500">Alunos e professores do lab (contas admin não aparecem aqui).</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/admin/usuarios/lixeira" class="btn-secondary">Lixeira</a>
            <a href="/admin/usuarios/novo" class="btn-primary">+ Novo usuário</a>
        </div>
    </div>

    <div class="card">
        {{ tc.search_form('/admin/usuarios', query, 'Buscar por nome, e-mail ou username…') }}

        {% if paginator.total == 0 and query.search == '' %}
            <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
                <p class="text-sm text-slate-500">Nenhum usuário cadastrado ainda.</p>
            </div>
        {% elseif paginator.items is empty %}
            {{ tc.empty_search_state('/admin/usuarios', query, 'usuário') }}
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                            {{ tc.sort_th('Nome', 'name', '/admin/usuarios', query) }}
                            {{ tc.sort_th('E-mail / username', 'email', '/admin/usuarios', query) }}
                            {{ tc.sort_th('Papel', 'role', '/admin/usuarios', query) }}
                            {{ tc.sort_th('Status', 'status', '/admin/usuarios', query) }}
                            {{ tc.sort_th('Cadastrado em', 'created', '/admin/usuarios', query) }}
                            <th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for user in paginator.items %}
                            <tr data-row>
                                <td class="py-3 pr-4 font-medium text-slate-800">{{ user.name }}</td>
                                <td class="py-3 pr-4 text-slate-500">
                                    {{ user.email }}<br>
                                    <span class="font-mono text-xs text-slate-400">{{ user.mysqlLogin }}</span>
                                </td>
                                <td class="py-3 pr-4">
                                    <form
                                        x-data="ajaxForm({
                                            confirmTitle: 'Trocar papel',
                                            confirmMessage: (e) => 'Alterar o papel de {{ user.name|e('js') }} para ' + e.target.selectedOptions[0].text + '?',
                                            confirmLabel: 'Trocar papel',
                                        })"
                                        @change="submit" method="post" action="/admin/usuarios/{{ user.id }}/papel"
                                    >
                                        <select name="role" :disabled="loading" class="field-input !w-auto !py-1.5 text-xs">
                                            {% for role in roles %}
                                                <option value="{{ role.value }}" {{ role == user.role ? 'selected' : '' }}>{{ role.label() }}</option>
                                            {% endfor %}
                                        </select>
                                    </form>
                                </td>
                                <td class="py-3 pr-4">
                                    <form
                                        x-data="ajaxForm({
                                            confirmTitle: '{{ user.active ? 'Desativar conta' : 'Reativar conta' }}',
                                            confirmMessage: '{{ user.active ? 'Desativar' : 'Reativar' }} a conta de {{ user.name|e('js') }}?{{ user.active ? ' A pessoa não vai conseguir mais logar nem acessar o phpMyAdmin até reativar.' : '' }}',
                                            confirmLabel: '{{ user.active ? 'Desativar' : 'Reativar' }}',
                                            danger: {{ user.active ? 'true' : 'false' }},
                                        })"
                                        @submit.prevent="submit" method="post" action="/admin/usuarios/{{ user.id }}/status"
                                    >
                                        <button :disabled="loading" type="submit" class="{{ user.active ? 'badge-indigo' : 'badge-slate' }}">
                                            {{ user.active ? 'Ativo' : 'Inativo' }}
                                        </button>
                                    </form>
                                </td>
                                <td class="py-3 pr-4 text-slate-500">{{ user.createdAt|date('d/m/Y') }}</td>
                                <td class="py-3">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/admin/usuarios/{{ user.id }}/editar" class="btn-secondary !px-3 !py-1.5 text-xs">Editar</a>
                                        <form
                                            x-data="ajaxForm({
                                                confirmTitle: 'Excluir usuário',
                                                confirmMessage: 'Excluir a conta de {{ user.name|e('js') }}? Fica na lixeira, dá pra restaurar depois.',
                                                confirmLabel: 'Excluir',
                                                removeRow: true,
                                            })"
                                            @submit.prevent="submit"
                                            method="post" action="/admin/usuarios/{{ user.id }}/excluir"
                                        >
                                            <button :disabled="loading" type="submit" class="btn-danger !px-3 !py-1.5 text-xs">
                                                <span x-show="!loading">Excluir</span>
                                                <span x-show="loading" x-cloak>Excluindo…</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {{ tc.pagination('/admin/usuarios', paginator, query) }}
        {% endif %}
    </div>
{% endblock %}
