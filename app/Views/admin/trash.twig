{% extends 'layouts/app.twig' %}

{% block content %}
    <div class="mb-8">
        <a href="/admin/usuarios" class="text-sm text-slate-500 hover:text-slate-700">← Voltar para usuários</a>
        <h1 class="mt-2 text-2xl font-semibold text-slate-900">Lixeira</h1>
        <p class="mt-1 text-sm text-slate-500">
            Contas excluídas — os dados e os schemas continuam intactos, só o acesso fica bloqueado até restaurar.
        </p>
    </div>

    <div class="card">
        {% if users is empty %}
            <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
                <p class="text-sm text-slate-500">A lixeira está vazia.</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                            <th class="py-2 pr-4 font-medium">Nome</th>
                            <th class="py-2 pr-4 font-medium">E-mail / username</th>
                            <th class="py-2 pr-4 font-medium">Papel</th>
                            <th class="py-2 pr-4 font-medium">Excluído em</th>
                            <th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for user in users %}
                            <tr data-row>
                                <td class="py-3 pr-4 font-medium text-slate-800">{{ user.name }}</td>
                                <td class="py-3 pr-4 text-slate-500">
                                    {{ user.email }}<br>
                                    <span class="font-mono text-xs text-slate-400">{{ user.mysqlLogin }}</span>
                                </td>
                                <td class="py-3 pr-4"><span class="badge-slate">{{ user.role.label() }}</span></td>
                                <td class="py-3 pr-4 text-slate-500">{{ user.deletedAt|date('d/m/Y H:i') }}</td>
                                <td class="py-3">
                                    <div class="flex items-center justify-end">
                                        <form
                                            x-data="ajaxForm({
                                                confirmTitle: 'Restaurar conta',
                                                confirmMessage: 'Restaurar a conta de {{ user.name|e('js') }}? O acesso volta a funcionar normalmente.',
                                                confirmLabel: 'Restaurar',
                                                danger: false,
                                                removeRow: true,
                                            })"
                                            @submit.prevent="submit"
                                            method="post" action="/admin/usuarios/{{ user.id }}/restaurar"
                                        >
                                            <button :disabled="loading" type="submit" class="btn-secondary !px-3 !py-1.5 text-xs">
                                                <span x-show="!loading">Restaurar</span>
                                                <span x-show="loading" x-cloak>Restaurando…</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
