{% extends 'layouts/app.twig' %}

{% block content %}
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-900">Logs de erro</h1>
        <p class="mt-1 text-sm text-slate-500">Erros e avisos da aplicação (guardados por 14 dias). O detalhe completo continua no <code>docker logs</code>.</p>
    </div>

    <form method="get" action="/admin/logs" class="card mb-6 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
        <select name="dia" class="field-input">
            {% for d in days %}
                <option value="{{ d }}" {{ d == date ? 'selected' }}>{{ d|date('d/m/Y') }}</option>
            {% else %}
                <option value="">Nenhum log ainda</option>
            {% endfor %}
        </select>
        <select name="nivel" class="field-input">
            <option value="">Todos os níveis</option>
            {% for l in levels %}
                <option value="{{ l }}" {{ l == level ? 'selected' }}>{{ l }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn-primary">Filtrar</button>
    </form>

    {% if total == 0 %}
        <div class="card text-center">
            <p class="py-6 text-sm text-slate-500">Nenhum erro registrado nesse dia. 🎉</p>
        </div>
    {% else %}
        <div class="card mb-6">
            <h2 class="mb-3 text-base font-semibold text-slate-900">Problemas recorrentes <span class="text-sm font-normal text-slate-400">({{ total }} ocorrência{{ total == 1 ? '' : 's' }})</span></h2>
            <ul class="divide-y divide-slate-100 text-sm">
                {% for g in groups %}
                    <li class="flex items-start gap-3 py-2">
                        <span class="{{ g.level in ['critical', 'error'] ? 'badge-rose' : 'badge-amber' }}">{{ g.level }}</span>
                        <div class="min-w-0 flex-1">
                            <p class="break-words text-slate-800">{{ g.message }}</p>
                            <p class="font-mono text-xs text-slate-400">{{ g.location }} · última às {{ g.last|date('H:i:s') }}</p>
                        </div>
                        <span class="badge-slate">{{ g.count }}×</span>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="card">
            <h2 class="mb-3 text-base font-semibold text-slate-900">Entradas recentes</h2>
            <ul class="divide-y divide-slate-100 text-sm">
                {% for e in entries %}
                    <li class="py-2" x-data="{ open: false }">
                        <button type="button" @click="open = !open" class="flex w-full items-start gap-3 text-left">
                            <span class="whitespace-nowrap font-mono text-xs text-slate-400">{{ e.time|date('H:i:s') }}</span>
                            <span class="{{ e.level in ['critical', 'error'] ? 'badge-rose' : 'badge-amber' }}">{{ e.level }}</span>
                            <span class="min-w-0 flex-1 break-words text-slate-800">{{ e.message }}</span>
                            <span class="whitespace-nowrap font-mono text-xs text-slate-400">{{ e.route }}{% if e.user_id %} · #{{ e.user_id }}{% endif %}</span>
                        </button>
                        {% if e.trace %}
                            <pre x-show="open" x-cloak class="mt-2 overflow-x-auto rounded-lg bg-slate-900 p-3 text-xs text-slate-100">{{ e.location }}
{{ e.trace }}</pre>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
