{# Busca + ordenação + paginação server-side (App\Support\TableQuery/TableFilter/Paginator).
   Tudo aqui é link/form GET puro — funciona mesmo sem JS, igual o resto da app.

   A busca usa hx-get com debounce (dispara sozinha enquanto digita, sem precisar de Enter
   nem de recarregar a página) e troca só o container de resultados via hx-select/hx-swap,
   pra não perder o foco do campo de busca — por isso todo call site precisa envolver a
   tabela/lista + paginação num <div id="{results_id}">. O form em si fica com
   hx-boost="false" pra não competir com o hx-get do input (evita 2 requisições no Enter);
   sem JS, o Enter ainda funciona, é um <form method="get"> de verdade. #}

{% macro search_form(action, query, placeholder, results_id) %}
    <form hx-boost="false" method="get" action="{{ action }}" class="relative mb-4 max-w-sm">
        {% if query.sort %}<input type="hidden" name="sort" value="{{ query.sort }}">{% endif %}
        {% if query.direction == 'desc' %}<input type="hidden" name="dir" value="desc">{% endif %}
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5A6.5 6.5 0 114 10.5a6.5 6.5 0 0113 0z"/>
        </svg>
        <input
            type="search" name="q" value="{{ query.search }}" placeholder="{{ placeholder }}"
            class="field-input pl-9"
            hx-get="{{ action }}"
            hx-trigger="input changed delay:400ms, search"
            hx-select="#{{ results_id }}"
            hx-target="#{{ results_id }}"
            hx-swap="outerHTML"
            hx-push-url="true"
            hx-include="closest form"
        >
    </form>
{% endmacro %}

{% macro sort_th(label, key, action, query, extra_class = '') %}
    <th class="py-2 pr-4 font-medium {{ extra_class }}">
        <a
            href="{{ action }}{{ query.urlWith({ sort: key, dir: query.nextDirectionFor(key), page: 1 }) }}"
            class="inline-flex items-center gap-1 hover:text-slate-600 {{ query.isSortedBy(key) ? 'text-slate-600' : '' }}"
        >
            {{ label }}
            <svg
                class="h-3 w-3 {{ (query.isSortedBy(key) and query.direction == 'desc') ? 'rotate-180' : '' }} {{ query.isSortedBy(key) ? '' : 'opacity-30' }}"
                fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
            >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </a>
    </th>
{% endmacro %}

{% macro pagination(action, paginator, query) %}
    {% if paginator.total > 0 %}
        <div class="mt-4 flex flex-col gap-3 border-t border-slate-100 pt-4 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
            <span>Mostrando {{ paginator.from() }}–{{ paginator.to() }} de {{ paginator.total }} registro{{ paginator.total == 1 ? '' : 's' }}</span>
            {% if paginator.lastPage() > 1 %}
                <div class="flex items-center gap-2">
                    {% if paginator.hasPrevious() %}
                        <a href="{{ action }}{{ query.urlWith({ page: paginator.page - 1 }) }}" class="btn-secondary !px-3 !py-1.5 text-xs">← Anterior</a>
                    {% else %}
                        <span class="btn-secondary !px-3 !py-1.5 text-xs pointer-events-none opacity-40">← Anterior</span>
                    {% endif %}
                    <span class="px-1 text-xs text-slate-400">Página {{ paginator.page }} de {{ paginator.lastPage() }}</span>
                    {% if paginator.hasNext() %}
                        <a href="{{ action }}{{ query.urlWith({ page: paginator.page + 1 }) }}" class="btn-secondary !px-3 !py-1.5 text-xs">Próxima →</a>
                    {% else %}
                        <span class="btn-secondary !px-3 !py-1.5 text-xs pointer-events-none opacity-40">Próxima →</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% macro empty_search_state(action, query, label) %}
    <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
        <p class="text-sm text-slate-500">Nenhum {{ label }} encontrado para "{{ query.search }}".</p>
        <a href="{{ action }}" class="mt-2 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-700">Limpar busca</a>
    </div>
{% endmacro %}
