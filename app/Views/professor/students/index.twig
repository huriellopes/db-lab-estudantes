{% extends 'layouts/app.twig' %}

{% block content %}
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Alunos</h1>
            <p class="mt-1 text-sm text-slate-500">Veja, edite e gerencie as contas de alunos cadastrados.</p>
        </div>
        <span class="badge-indigo self-start">{{ students|length }} aluno{{ students|length == 1 ? '' : 's' }}</span>
    </div>

    <div class="card">
        {% if students is empty %}
            <div class="rounded-xl border border-dashed border-slate-200 py-10 text-center">
                <p class="text-sm text-slate-500">Nenhum aluno cadastrado ainda.</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400">
                            <th class="py-2 pr-4 font-medium">Nome</th>
                            <th class="py-2 pr-4 font-medium">E-mail</th>
                            <th class="py-2 pr-4 font-medium">Schemas</th>
                            <th class="py-2 pr-4 font-medium">Cadastrado em</th>
                            <th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for student in students %}
                            <tr data-row>
                                <td class="py-3 pr-4 font-medium text-slate-800">{{ student.name }}</td>
                                <td class="py-3 pr-4 text-slate-500">{{ student.email }}</td>
                                <td class="py-3 pr-4"><span class="badge-slate">{{ student.schemasCount }}</span></td>
                                <td class="py-3 pr-4 text-slate-500">{{ student.createdAt|date('d/m/Y') }}</td>
                                <td class="py-3">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/professor/alunos/{{ student.id }}/editar" class="btn-secondary !px-3 !py-1.5 text-xs">Editar</a>
                                        <form
                                            x-data="ajaxForm({
                                                confirmTitle: 'Excluir aluno',
                                                confirmMessage: 'Excluir a conta de {{ student.name|e('js') }}? Isso apaga também todos os schemas dela.',
                                                confirmLabel: 'Excluir',
                                                removeRow: true,
                                            })"
                                            @submit.prevent="submit"
                                            method="post" action="/professor/alunos/{{ student.id }}/excluir"
                                        >
                                            <button :disabled="loading" type="submit" class="btn-danger !px-3 !py-1.5 text-xs">
                                                <span x-show="!loading">Excluir</span>
                                                <span x-show="loading" x-cloak>Excluindo…</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
