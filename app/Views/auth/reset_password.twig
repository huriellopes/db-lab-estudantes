{% extends 'layouts/guest.twig' %}
{% import 'macros/forms.twig' as forms %}

{% block content %}
    <h1 class="mb-1 text-xl font-semibold text-slate-900">Redefinir senha</h1>

    {% if not valid %}
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {{ errors[0]|default('Esse link é inválido, expirou ou já foi usado.') }}
        </div>
        <a href="/esqueci-senha" class="font-medium text-indigo-600 hover:text-indigo-700">Pedir um link novo →</a>
    {% else %}
        <p class="mb-6 text-sm text-slate-500">Escolha uma senha nova pra sua conta.</p>

        {% for error in errors %}
            <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ error }}</div>
        {% endfor %}

        <form method="post" action="/redefinir-senha" class="space-y-4">
            {{ csrf_field() }}
            <input type="hidden" name="token" value="{{ token }}">
            {{ forms.password_field('password', 'password', 'Nova senha', password_min_length) }}
            {{ forms.password_field('password_confirm', 'password_confirm', 'Confirmar nova senha', password_min_length) }}
            <button type="submit" class="btn-primary w-full">Redefinir senha</button>
        </form>
    {% endif %}
{% endblock %}
