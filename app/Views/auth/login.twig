{% extends 'layouts/guest.twig' %}
{% import 'macros/forms.twig' as forms %}

{% block content %}
    <h1 class="mb-1 text-xl font-semibold text-slate-900">Entrar</h1>
    <p class="mb-6 text-sm text-slate-500">Acesse sua conta para gerenciar seus schemas.</p>

    {% for error in errors %}
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ error }}</div>
    {% endfor %}

    <form method="post" action="/login" class="space-y-4">
        {{ csrf_field() }}
        <div>
            <label for="identifier" class="field-label">E-mail ou username</label>
            <input type="text" id="identifier" name="identifier" value="{{ old.identifier }}" required autofocus class="field-input">
        </div>
        {{ forms.password_field('password', 'password', 'Senha') }}
        {# "Esqueci minha senha" tirado da tela por enquanto (a rota/fluxo continuam
           existindo em App\Controllers\PasswordResetController — só a exposição na UI
           foi removida). #}
        <button type="submit" class="btn-primary w-full">Entrar</button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-500">
        Ainda não tem conta?
        <a href="/register" class="font-medium text-indigo-600 hover:text-indigo-700">Cadastre-se</a>
    </p>
{% endblock %}
