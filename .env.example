# Copie este arquivo para ".env" e ajuste as senhas antes de subir o ambiente.
# NUNCA versione o arquivo ".env" real (já está no .gitignore).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=schoolapp
MYSQL_USER=appuser
MYSQL_PASSWORD=troque_esta_senha_app

# --- Portas expostas no host ---
APP_PORT=8080
PMA_PORT=8081
MYSQL_PORT=3307

# --- URL do phpMyAdmin usada nos links dentro da aplicação ---
PMA_URL=http://localhost:8081

# --- Endereço mostrado na página "Conectar via SGBD" para quem quiser usar um cliente
# local (TablePlus, DBeaver, MySQL Workbench...). Deixe "localhost" se você roda o
# docker-compose na sua própria máquina. Se subir isso num servidor remoto, troque para
# o hostname/IP real do servidor (a pessoa vai precisar de um túnel SSH até essa porta).
DB_PUBLIC_HOST=localhost
